{
  "name": "clarity-film",
  "version": "1.0.0",
  "private": true,
  "description": "清醒录：纯音乐驱动的暗黑星盘语录混剪（Remotion）",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render src/index.ts ClarityFilm out/clarity-film.mp4",
    "still": "remotion still src/index.ts ClarityFilm",
    "render:portrait": "remotion render src/index.ts ClarityFilmPortrait out/clarity-film-portrait.mp4",
    "timeline": "node tools/timeline.mjs",
    "stills": "node tools/stills.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.547",
    "@remotion/google-fonts": "4.0.547",
    "@remotion/media": "4.0.547",
    "@remotion/media-utils": "4.0.547",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.547"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
